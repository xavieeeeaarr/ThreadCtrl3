@model ThrdCtrl2.Models.SecurityViewModel
@{
    ViewData["Title"] = "Global Security & Audit";
    Layout = "_LayoutSuperAdmin";
}

<div class="dashboard">

    <!-- HEADER -->
    <div class="overview-header">
        <div>
            <h1>Global Security & Audit</h1>
            <p class="overview-sub">
                Monitoring system-wide movements across all companies.
            </p>
        </div>
        <div class="overview-actions">
            <button class="btn-primary" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
    </div>

    <!-- LOWER SECTION -->
    <div class="lower-grid-inv">
        <div class="table-card-big">
            
            <!-- INLINE FILTERS -->
            <form method="get" class="d-flex align-items-end gap-3 mb-4 p-2 border-bottom border-secondary pb-4">
                <div class="filter-group">
                    <label class="small text-white-50">Filter by Company</label>
                    <select name="companyId" class="filter-input-alt">
                        <option value="">All Companies</option>
                        @foreach (var comp in Model.Companies)
                        {
                            @if (Model.SelectedCompanyId == comp.CompanyID)
                            {
                                <option value="@comp.CompanyID" selected>@comp.CompanyName</option>
                            }
                            else
                            {
                                <option value="@comp.CompanyID">@comp.CompanyName</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="small text-white-50">Filter by Role</label>
                    <select name="roleName" class="filter-input-alt">
                        @foreach (var role in Model.Roles)
                        {
                            @if (Model.SelectedRole == role)
                            {
                                <option value="@role" selected>@role</option>
                            }
                            else
                            {
                                <option value="@role">@role</option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="btn-primary-small">Apply Filters</button>
                <a href="@Url.Action("GlobalSecurity")" class="btn-outline-small text-decoration-none">Reset</a>
            </form>

            <div class="table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Company</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Details</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs.Any())
                        {
                            foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td>@log.Timestamp.ToString("MMM dd, HH:mm")</td>
                                    <td class="fw-bold text-primary">@log.CompanyName</td>
                                    <td>@(log.UserFullName ?? "System")</td>
                                    <td class="text-white-50 small">@(log.RoleName ?? "System")</td>
                                    <td class="fw-bold">@log.Action</td>
                                    <td>
                                        <span class="status-blue">@log.Module</span>
                                    </td>
                                    <td>@log.Details</td>
                                    <td class="small">@log.IPAddress</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 20px;">No global audit logs found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TABLE FOOTER -->
            <div class="table-footer">
                <div>Showing @Model.Logs.Count logs</div>

                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("GlobalSecurity", new { companyId = Model.SelectedCompanyId, roleName = Model.SelectedRole, page = Model.CurrentPage - 1 })" class="page-btn">‹</a>
                    }
                    
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <button class="page-btn active">@i</button>
                        }
                        else if (i <= 5 || i > Model.TotalPages - 2)
                        {
                            <a href="@Url.Action("GlobalSecurity", new { companyId = Model.SelectedCompanyId, roleName = Model.SelectedRole, page = i })" class="page-btn">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("GlobalSecurity", new { companyId = Model.SelectedCompanyId, roleName = Model.SelectedRole, page = Model.CurrentPage + 1 })" class="page-btn">›</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
