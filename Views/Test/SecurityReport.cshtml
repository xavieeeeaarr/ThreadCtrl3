@model ThrdCtrl2.Models.SecurityViewModel
@{
    Layout = null;
    var companyName = ViewData["CompanyName"] as string ?? "ThreadCtrl Enterprise";
    var reportDate = ViewData["ReportDate"] as string ?? DateTime.Now.ToString("MMM dd, yyyy HH:mm");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Audit Report - @companyName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; margin: 0; background: #fff !important; color: #000 !important; }
            .report-container { box-shadow: none !important; border: none !important; margin: 0 !important; width: 100% !important; }
            .page-break { page-break-before: always; }
        }

        body {
            background-color: #f8f9fa;
            color: #333;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 40px 0;
        }

        .report-container {
            background: #fff;
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px;
            box-shadow: 0 0 15px rgba(0,0,0,0.05);
            border-top: 5px solid #a7d417;
        }

        .header-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            margin-bottom: 40px;
        }

        .report-title h1 {
            font-size: 24px;
            font-weight: 800;
            color: #1a1a1a;
            margin: 0;
        }

        .report-title p {
            font-size: 14px;
            color: #666;
            margin: 5px 0 0 0;
        }

        .company-info {
            text-align: right;
        }

        .company-info h2 {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
            color: #1a1a1a;
        }

        .kpi-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .kpi-card {
            padding: 15px;
            background: #fbfcf8;
            border: 1px solid #eef2dc;
            border-radius: 4px;
        }

        .kpi-label {
            font-size: 11px;
            text-transform: uppercase;
            color: #888;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .kpi-value {
            font-size: 20px;
            font-weight: 800;
            color: #1a1a1a;
        }

        .section-header {
            background: #f8f9fa;
            padding: 10px 15px;
            border-left: 4px solid #a7d417;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .audit-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        .audit-table th {
            text-align: left;
            padding: 12px 10px;
            background: #f1f1f1;
            border-bottom: 2px solid #ddd;
            color: #555;
            text-transform: uppercase;
            font-weight: 700;
        }

        .audit-table td {
            padding: 10px;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }

        .audit-table tr:nth-child(even) {
            background: #fafafa;
        }

        .module-tag {
            display: inline-block;
            padding: 2px 8px;
            background: #eef2dc;
            border: 1px solid #d4e0a5;
            color: #5d7015;
            font-weight: 700;
            font-size: 10px;
            border-radius: 3px;
        }

        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 11px;
            color: #999;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

        .btn-print {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #a7d417;
            color: #000;
            border: none;
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .btn-print:hover {
            background: #b8e61a;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <button onclick="window.print()" class="btn-print no-print">
        <i class="bi bi-printer-fill me-2"></i>CONFIRM PRINT
    </button>

    <div class="report-container">
        <div class="header-grid">
            <div class="report-title">
                <h1>SECURITY AUDIT LOG</h1>
                <p>Generated by ThreadCtrl Monitoring Engine</p>
                <p>Status: @(Model.SelectedModule ?? "System Wide Tracking")</p>
            </div>
            <div class="company-info">
                <h2>@companyName</h2>
                <p style="font-size: 12px; margin: 5px 0;">Generation Date: @reportDate</p>
                <p style="font-size: 11px; color: #888;">Document ID: SEC-@DateTime.Now.Ticks.ToString().Substring(10)</p>
            </div>
        </div>

        <div class="section-header">Summary of Activity (Last 24h)</div>
        <div class="kpi-row">
            <div class="kpi-card">
                <div class="kpi-label">Security Alerts</div>
                <div class="kpi-value">@Model.Stats.SecurityAlerts</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Failed Logins</div>
                <div class="kpi-value text-danger">@Model.Stats.FailedLogins24h</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Data Changes</div>
                <div class="kpi-value">@Model.Stats.DataModifications24h</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Active Sessions</div>
                <div class="kpi-value">@Model.Stats.ActiveSessions</div>
            </div>
        </div>

        <div class="section-header">Detailed Audit Trail</div>
        <table class="audit-table">
            <thead>
                <tr>
                    <th style="width: 15%">Timestamp</th>
                    <th style="width: 15%">User Account</th>
                    <th style="width: 15%">Action</th>
                    <th style="width: 15%">Module</th>
                    <th style="width: 25%">Transaction Details</th>
                    <th style="width: 15%">Origin IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td><strong>@log.Timestamp.ToString("MMM dd, yyyy")</strong><br/>@log.Timestamp.ToString("HH:mm:ss")</td>
                        <td>
                            <div style="font-weight: 700;">@(log.UserFullName ?? "System Process")</div>
                            <div style="font-size: 10px; color: #888;">ID: @log.UserID</div>
                        </td>
                        <td>@log.Action</td>
                        <td><span class="module-tag">@log.Module</span></td>
                        <td>@log.Details</td>
                        <td><code>@log.IPAddress</code></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="footer">
            <p><strong>CONFIDENTIAL DOCUMENT:</strong> DO NOT DISTRIBUTE UNLESS AUTHORIZED.</p>
            <p>Certified by the Audit Department. &copy; @DateTime.Now.Year ThreadCtrl Enterprise. All rights reserved.</p>
        </div>
    </div>

</body>
</html>
