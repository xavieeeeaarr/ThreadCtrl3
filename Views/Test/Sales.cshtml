                            </td>
                        </tr>

                        <tr>
                            <td>SO-2025-092</td>
                            <td>Julia Montes</td>'
                            <td>Oct 29, 2025</td>'
                            <td><span class="status in">In Stock</span></td>
                            <td>₱100,000</td>
                            <td class="actions">
                                <i class="bi bi-pencil"></i>
                                <i class="bi bi-trash"></i>
                            </td>
                        </tr>

                        <tr>
                            <td>SO-2025-093</td>
