@{
    ViewData["Title"] = "Sales Order";
    Layout = "_LayoutDashboard";
}


<div class="dashboard">

    <!-- HEADER -->
    <div class="overview-header">

        <div>
            <h1>Sales Orders</h1>
            <p class="overview-sub">
                Manage customer orders and shipments
            </p>
        </div>

        <div class="overview-actions">
            <button class="btn-outline"><i class="bi bi-file-earmark-fill"></i> Export Report</button>
            <button class="btn-primary"><i class="bi bi-plus-square-fill"></i> Add Sales Order</button>
        </div>

    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">

        <div class="filter-group">
            <label>Status</label>
            <select class="filter-input">
                <option>All Statuses</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Date</label>
            <select class="filter-input">
                <option>dd/mm/yy</option>
            </select>
        </div>


        <div class="filter-group mt-2">
            <button class="btn-primary-small">Apply Filters</button>
        </div>

    </div>



    <!-- LOWER SECTION -->
    <div class="lower-grid-inv">

        <!-- INVENTORY TABLE -->
        <div class="table-card-big">

            <div class="table-header">
                <h3>Inventory Items</h3>
                <span class="view-all">View All</span>
            </div>

            <div class="table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            
                            <td>SO-2025-089</td>
                            <td>Kathryn Bernardo</td>'
                            <td>Oct 20, 2025</td>'
                            <td><span class="status in">In Stock</span></td>
                            <td>₱100,000</td>
                            <td class="actions">
                                <i class="bi bi-pencil"></i>
                                <i class="bi bi-trash"></i>
                            </td>
                        </tr>

                        <tr>
