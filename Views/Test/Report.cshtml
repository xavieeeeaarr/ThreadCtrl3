@model ThrdCtrl2.Models.ReportViewModel
@{
    ViewData["Title"] = "Reports & Valuation";
    Layout = "_LayoutDashboard";
}

<style>
    .charts-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-top: 50px; /* Substantial gap from summary cards */
        margin-bottom: 20px;
    }

    .chart-card {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
        padding: 20px;
        min-height: 350px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-header h3 {
        margin: 0;
        font-size: 1.1rem;
        color: #ffffff;
    }

    .stat-label.text-success.small { color: #a7d417 !important; }
    .stat-label.text-info.small { color: #0dcaf0 !important; }
    
    .status.received { background: rgba(167, 212, 23, 0.1); color: #a7d417; }
    .status.completed { background: rgba(13, 202, 240, 0.1); color: #0dcaf0; }

    /* Forcing full width for table card */
    .lower-grid {
        display: block !important;
    }
    
    .table-card {
        width: 100% !important;
    }

    canvas {
        max-width: 100% !important;
    }

    /* Fix PDF Button Contrast */
    .btn-primary {
        background: #a7d417 !important;
        color: #1a1a1a !important;
        border: none !important;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.9rem;
        letter-spacing: 0.2px;
    }

    .btn-primary:hover {
        background: #b8e61a !important;
        color: #000 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(167, 212, 23, 0.3);
    }

    .btn-primary i {
        color: #1a1a1a !important;
        font-size: 1.1rem;
    }
</style>

<div class="dashboard">
    <!-- HEADER -->
    <div class="overview-header">
        <div>
            <h1>Inventory Valuation Reports</h1>
            <p class="overview-sub">
                Real-time cost analysis and asset value tracking
            </p>
        </div>
        <div class="overview-actions">
            @* Removed Print and Excel as requested *@
            <a href="@Url.Action("ValuationReport", "Test", new { warehouseId = Model.SelectedWarehouseId, categoryId = Model.SelectedCategoryId })" 
               target="_blank" class="btn-primary text-decoration-none">
                <i class="bi bi-file-earmark-pdf-fill"></i> Generate Formal PDF
            </a>
        </div>
    </div>

    <!-- FILTER BAR (TOP) -->
    <div class="filter-bar mb-4">
        <form asp-action="Report" method="get" class="d-flex align-items-end gap-3">
            <div class="filter-group">
                <label>Warehouse</label>
                <select name="warehouseId" class="filter-input">
                    <option value="">All Warehouses</option>
                    @foreach (var w in Model.Warehouses)
                    {
                        <!option value="@w.WarehouseID" @(Model.SelectedWarehouseId == w.WarehouseID ? "selected" : "")>@w.WarehouseName</!option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>Category</label>
                <select name="categoryId" class="filter-input">
                    <option value="">All Categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <!option value="@c.CategoryID" @(Model.SelectedCategoryId == c.CategoryID ? "selected" : "")>@c.CategoryName</!option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <button type="submit" class="btn-primary-small" style="height: 38px;">Apply Filters</button>
            </div>
        </form>
    </div>

    <!-- CARDS -->
    <div class="cards-grid">
        <div class="card">
            <div class="stat-label">Total Asset Value</div>
            <div class="stat-value">₱@Model.Valuation.TotalAssetValue.ToString("N0")</div>
            <div class="stat-label text-warning small"><i class="bi bi-arrow-up-right"></i> +5.2% vs last month</div>
        </div>

        <div class="card">
            <div class="stat-label">Avg. Unit Cost</div>
            <div class="stat-value">₱@Model.Valuation.AvgUnitCost.ToString("N2")</div>
            <div class="stat-label text-success small">Stable</div>
        </div>

        <div class="card">
            <div class="stat-label">Total SKUs</div>
            <div class="stat-value">@Model.Valuation.TotalSKUs</div>
            <div class="stat-label text-info small">+12 New this week</div>
        </div>

        <div class="card">
            <div class="stat-label">Top Category Value</div>
            <div class="stat-value">₱@Model.Valuation.TopCategoryValue.ToString("N0")</div>
            <div class="stat-label text-primary small">@Model.Valuation.TopCategoryName</div>
        </div>
    </div>

    <!-- CHARTS -->
    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Valuation History (Last 12 Months)</h3>
            </div>
            <div style="height: 280px;">
                <canvas id="valuationHistoryChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-header">
                <h3>Value by Category</h3>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="categoryPieChart"></canvas>
            </div>
        </div>
    </div>

    <!-- DETAILED VALUATION TABLE -->
    <div class="lower-grid">
        <div class="table-card">
            <div class="table-header d-flex justify-content-between align-items-center mb-3">
                <h3>Detailed Inventory Valuation</h3>
                <div class="search-box">
                    <input type="text" id="tableSearch" class="search-input" placeholder="Filter items..." style="max-width: 250px;">
                </div>
            </div>

            <div class="table-responsive">
                <table id="valuationTable">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Product Name</th>
                            <th>SKU</th>
                            <th>Category</th>
                            <th>Warehouse</th>
                            <th class="text-center">Qty On Hand</th>
                            <th>Unit Cost</th>
                            <th>Total Value</th>
                            <th>Last Reval Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.DetailedValuation.Any())
                        {
                            <tr><td colspan="9" class="text-center py-4 text-white-50">No inventory data found.</td></tr>
                        }
                        @{ int index = (Model.CurrentPage - 1) * Model.PageSize + 1; }
                        @foreach (var item in Model.DetailedValuation)
                        {
                            <tr>
                                <td class="text-white-50 small">@index</td>
                                <td class="fw-bold">@item.ProductName</td>
                                <td class="text-white-50">@item.SKU</td>
                                <td>@item.Category</td>
                                <td>@item.Warehouse</td>
                                <td class="text-center">@item.QtyOnHand.ToString("N0")</td>
                                <td>₱@item.UnitCost.ToString("N2")</td>
                                <td class="fw-bold">₱@item.TotalValue.ToString("N2")</td>
                                <td class="small text-white-50">@item.LastRevalDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- TABLE FOOTER -->
            <div class="table-footer mt-3">
                <div class="text-white-50 small">
                    Showing @(Model.TotalItems == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems entries
                </div>
                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-btn" href="@Url.Action("Report", new { page = Model.CurrentPage - 1, warehouseId = Model.SelectedWarehouseId, categoryId = Model.SelectedCategoryId })">‹</a>
                    }
                    else
                    {
                        <button class="page-btn disabled" disabled>‹</button>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <button class="page-btn active">@i</button>
                        }
                        else
                        {
                            <a class="page-btn" href="@Url.Action("Report", new { page = i, warehouseId = Model.SelectedWarehouseId, categoryId = Model.SelectedCategoryId })">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-btn" href="@Url.Action("Report", new { page = Model.CurrentPage + 1, warehouseId = Model.SelectedWarehouseId, categoryId = Model.SelectedCategoryId })">›</a>
                    }
                    else
                    {
                        <button class="page-btn disabled" disabled>›</button>
                    }
                </div>
            </div>
        </div>

        <!-- RECENT MOVEMENTS (FULL WIDTH BELOW) -->
        <div class="table-card mt-4">
            <div class="table-header">
                <h3>Recent Stock Movements</h3>
            </div>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Type</th>
                            <th>Product / Variant</th>
                            <th>Quantity</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.RecentMovements)
                        {
                            <tr>
                                <td>#@m.TransactionID</td>
                                <td>@m.Type</td>
                                <td class="text-white-50 small">@m.ProductVariant</td>
                                <td class="@(m.Quantity >= 0 ? "positive" : "negative")">
                                    @(m.Quantity >= 0 ? "+" + m.Quantity : m.Quantity.ToString())
                                </td>
                                <td>@m.Date.ToString("MMM dd, hh:mm tt")</td>
                                <td>
                                    <span class="status @m.Status.ToLower().Replace(":", "")">@m.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Valuation History Chart
            const historyCtx = document.getElementById('valuationHistoryChart').getContext('2d');
            const historyLabels = @Html.Raw(Json.Serialize(Model.ValuationHistory.Select(x => x.Month)));
            const historyData = @Html.Raw(Json.Serialize(Model.ValuationHistory.Select(x => x.Value)));

            new Chart(historyCtx, {
                type: 'bar',
                data: {
                    labels: historyLabels,
                    datasets: [{
                        label: 'Valuation',
                        data: historyData,
                        backgroundColor: '#38767e',
                        borderRadius: 4,
                        hoverBackgroundColor: '#a7d417'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { 
                                color: '#888',
                                callback: function(value) { return '₱' + value.toLocaleString(); }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#888' }
                        }
                    }
                }
            });

            // Category Pie Chart
            const pieCtx = document.getElementById('categoryPieChart').getContext('2d');
            const catLabels = @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(x => $"{x.CategoryName} ({x.Percentage:N0}%)")));
            const catData = @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(x => x.Value)));

            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catData,
                        backgroundColor: [
                            '#004d40', '#00695c', '#00796b', '#00897b', '#009688', '#26a69a', '#4db6ac', '#80cbc4'
                        ],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#888',
                                padding: 20,
                                usePointStyle: true,
                                font: { size: 11 }
                            }
                        }
                    }
                }
            });

            // Table Search
            $("#tableSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#valuationTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}


</div>
