@{
    ViewData["Title"] = "New Password";
}

<div class="page-wrapper">
    <div class="reg-container">
        <div class="reg-card">
            <div class="logo-area">
                <div class="logo-icon">
                    <img src="~/images/icon.png" alt="Logo" />
                </div>
                <div class="system-name">Reset Password</div>
                <div class="subtitle">Please choose a strong new password</div>
            </div>

            <form asp-action="ResetPassword" method="post" id="resetForm">
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input type="password" name="password" id="newPassword" class="form-control" placeholder="New Password" required />
                    <label class="form-label-black">New Password</label>
                    <div class="password-requirements text-white-50 small mt-1 opacity-75">
                        Min. 8 chars, must include: <b>A-Z, a-z, 0-9, & symbol</b>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm Password" required />
                    <label class="form-label-black">Confirm Password</label>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-success">Update Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('resetForm').onsubmit = function(e) {
            const pwd = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            
            const hasUpper = /[A-Z]/.test(pwd);
            const hasLower = /[a-z]/.test(pwd);
            const hasNumber = /[0-9]/.test(pwd);
            const hasSymbol = /[!@@#$%^&*(),.?":{}|<>]/.test(pwd);
            const minLength = pwd.length >= 8;

            if(!(hasUpper && hasLower && hasNumber && hasSymbol && minLength)) {
                alert("Password is too weak! Please follow the requirements: Min 8 chars, A-Z, a-z, 0-9, and a symbol.");
                e.preventDefault();
                return false;
            }

            if(pwd !== confirm) {
                alert("Passwords do not match!");
                e.preventDefault();
                return false;
            }
        };
    </script>
}
