@model ThrdCtrl2.Models.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "SA Dashboard";
    Layout = "_LayoutSuperAdmin";
}

<div class="dashboard">
    <div class="overview-header">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="overview-sub">Real-time system health and organization metrics.</p>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="cards-grid mt-4">
        <div class="card">
            <div class="stat-label">Total Companies</div>
            <div class="stat-value">@Model.TotalCompanies</div>
            <div class="stat-label text-primary">System Growth</div>
        </div>
        <div class="card">
            <div class="stat-label">Active Companies</div>
            <div class="stat-value text-success">@Model.ActiveCompanies</div>
            <div class="stat-label">Operational</div>
        </div>
        <div class="card">
            <div class="stat-label">Inactive</div>
            <div class="stat-value text-danger">@Model.InactiveCompanies</div>
            <div class="stat-label">Archived</div>
        </div>
        <div class="card">
            <div class="stat-label">Total Users</div>
            <div class="stat-value">@Model.TotalUsers</div>
            <div class="stat-label">Platform-wide</div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="lower-grid mt-4">
        <div class="table-card-big">
            <div class="table-header border-bottom border-secondary pb-3 mb-3">
                <h3 class="mb-0">System Activity Overview</h3>
            </div>
            <div style="height: 300px; display: flex; align-items: center; justify-content: center; background: #222; border-radius: 8px;">
                <div class="text-white-50 text-center">
                    <i class="bi bi-bar-chart-fill fs-1 d-block mb-2"></i>
                    Activity Chart Sample UI
                </div>
            </div>
        </div>

        <div class="health-card">
            <div class="table-header border-bottom border-secondary pb-3 mb-3">
                <h3 class="mb-0">Recent Companies</h3>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item bg-transparent border-secondary text-white px-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">sample_corp</div>
                            <div class="small text-white-50">Registered 2h ago</div>
                        </div>
                        <span class="status-green">Active</span>
                    </div>
                </div>
                 <div class="list-group-item bg-transparent border-secondary text-white px-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">antigravity_dev</div>
                            <div class="small text-white-50">Registered 5h ago</div>
                        </div>
                        <span class="status-green">Active</span>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3 pt-3 border-top border-secondary">
                <a asp-action="Companies" class="view-all text-decoration-none">View All Companies</a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ensure the lower-grid works well for SA dash */
    .lower-grid {
        grid-template-columns: 2fr 1fr;
    }
    
    @@media (max-width: 991.98px) {
        .lower-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
