@model ThrdCtrl2.Models.StockAdjustmentViewModel
@{
    ViewData["Title"] = "Stock Adjustments";
    Layout = "_LayoutDashboard";
}

<div class="dashboard">

    <!-- HEADER -->
    <div class="overview-header">

        <div>
            <h1>Stock Adjustments</h1>
            <p class="overview-sub">
                Manage inventory corrections, damages, and write-offs.
            </p>
        </div>

        <div class="overview-actions">
            <a href="@Url.Action("Security", "Test", new { module = "Inventory" })" class="btn-outline text-decoration-none">
                <i class="bi bi-file-earmark-fill"></i> Adjustment Log
            </a>
            <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#newAdjustmentModal">
                <i class="bi bi-plus-square-fill"></i> New Adjustment Request
            </button>
        </div>

    </div>

    <!-- TABS -->
    <div class="proc-tabs">
        <a href="?tab=All" class="@(Model.ActiveTab == "All" ? "active-tab" : "") text-white" style="text-decoration: none;">All Adjustments</a>
        <a href="?tab=Pending" class="@(Model.ActiveTab == "Pending" ? "active-tab" : "") text-white ms-4" style="text-decoration: none;">Pending Approval</a>
        <a href="?tab=Rejected" class="@(Model.ActiveTab == "Rejected" ? "active-tab" : "") text-white ms-4" style="text-decoration: none;">Rejected</a>
    </div>

    <!-- CARDS BELOW -->
    <div class="cards-grid">

        <div class="card">
            <div class="stat-label">Pending Approval</div>
            <div class="stat-value">@Model.PendingCount</div>
            <div class="stat-label">Action Required</div>
        </div>

        <div class="card">
            <div class="stat-label">Damages (This Month)</div>
            <div class="stat-value text-danger">-(@Model.ThisMonthDamages)</div>
            <div class="stat-label">Units removed</div>
        </div>

        <div class="card">
            <div class="stat-label">Corrections (Net)</div>
            <div class="stat-value">@(Model.NetCorrections > 0 ? "+" : "")@Model.NetCorrections</div>
            <div class="stat-label">Audit findings</div>
        </div>

    </div>

    <!-- FILTER BAR -->
    <form method="get" class="filter-bar">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        <div class="filter-group">
            <label>Types</label>
            <select name="type" class="filter-input">
                <option value="All Types" selected="@(Model.SelectedType == "All Types")">All Types</option>
                <option value="Damage" selected="@(Model.SelectedType == "Damage")">Damage</option>
                <option value="Correction" selected="@(Model.SelectedType == "Correction")">Correction</option>
                <option value="Write-off" selected="@(Model.SelectedType == "Write-off")">Write-off</option>
                <option value="Transfer Error" selected="@(Model.SelectedType == "Transfer Error")">Transfer Error</option>
            </select>
        </div>

        <div class="filter-group">
            <label>&nbsp;</label>
            <button type="submit" class="btn-primary-small" style="height: 40px; width: auto; min-width: 150px; margin-top: 0;">Apply Filters</button>
        </div>
    </form>

    <!-- LOWER SECTION -->
    <div class="lower-grid-inv">

        <div class="table-card-big">

            <div class="table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Product Variant</th>
                            <th>Warehouse</th>
                            <th>Type</th>
                            <th>Change</th>
                            <th>Requested By</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Adjustments == null || !Model.Adjustments.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-white-50">No stock adjustments found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var adj in Model.Adjustments)
                            {
                                <tr>
                                    <td>ADJ-@adj.AdjustmentID.ToString("D4")</td>
                                    <td>@adj.ProductName (@adj.VariantInfo)</td>
                                    <td>@adj.WarehouseName</td>
                                    <td>
                                        <span class="@(adj.Type == "Damage" ? "status-red" : adj.Type == "Correction" ? "status-blue" : "status-green")">
                                            @adj.Type
                                        </span>
                                    </td>
                                    <td class="@(adj.ChangeQuantity < 0 ? "text-danger" : "text-success") fw-bold">
                                        @(adj.ChangeQuantity > 0 ? "+" : "")@adj.ChangeQuantity
                                    </td>
                                    <td>@adj.RequestedByName</td>
                                    <td>
                                        <span class="status @adj.Status.ToLower()">@adj.Status</span>
                                    </td>
                                    <td>@adj.DateRequested.ToString("MM/dd/yyyy HH:mm")</td>
                                    <td class="actions">
                                        <i class="bi bi-eye" title="View Details"></i>
                                        @if (adj.Status == "Pending" && (User.IsInRole("Super Admin") || User.IsInRole("Company Admin")))
                                        {
                                            <i class="bi bi-check-circle text-success ms-2 cursor-pointer" onclick="approveAdjustment(@adj.AdjustmentID)" title="Approve"></i>
                                            <i class="bi bi-x-circle text-danger ms-2 cursor-pointer" onclick="rejectAdjustment(@adj.AdjustmentID)" title="Reject"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <!-- TABLE FOOTER -->
            <div class="table-footer">
                <div class="text-white-50 small">
                    Showing @(Model.TotalItems == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems entries
                </div>
                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-btn" href="@Url.Action("Stock", new { page = Model.CurrentPage - 1, tab = Model.ActiveTab, type = Model.SelectedType })">‹</a>
                    }
                    else
                    {
                        <button class="page-btn disabled" disabled>‹</button>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <button class="page-btn active">@i</button>
                        }
                        else
                        {
                            <a class="page-btn" href="@Url.Action("Stock", new { page = i, tab = Model.ActiveTab, type = Model.SelectedType })">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-btn" href="@Url.Action("Stock", new { page = Model.CurrentPage + 1, tab = Model.ActiveTab, type = Model.SelectedType })">›</a>
                    }
                    else
                    {
                        <button class="page-btn disabled" disabled>›</button>
                    }
                </div>
            </div>

        </div>

    </div>

</div>

<!-- NEW ADJUSTMENT MODAL -->
<div class="modal fade" id="newAdjustmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-plus-square-fill me-2"></i>New Stock Adjustment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="requestAdjForm">
                <div class="modal-body">
                    <div id="adjErrorMessage" class="alert alert-danger d-none"></div>

                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Product / Variant</label>
                        <select name="variantId" id="adjVariant" class="form-select bg-black text-white border-secondary" required onchange="checkAdjWarehouseStock()">
                            <option value="">Select Variant</option>
                            @foreach (var v in Model.AllVariants)
                            {
                                <option value="@v.VariantID" data-barcode="@v.Barcode">@v.ProductName (@v.SKU - @v.Size / @v.Color)</option>
                            }
                        </select>
                        <div class="mt-2 d-flex gap-2">
                             <button type="button" class="btn btn-sm btn-outline-warning" onclick="startScanner('adjReader', 'adjVariant', 'adjScanStatus', 'adjStartBtn', 'adjStopBtn', 'adjReaderContainer')">
                                <i class="bi bi-qr-code-scan me-1"></i> Scan QR
                            </button>
                            <span id="adjScanStatus" class="small"></span>
                        </div>
                    </div>

                    <div id="adjReaderContainer" style="display: none;" class="mt-2 border border-secondary rounded p-2">
                        <div id="adjReader" style="width: 100%; min-height: 250px;"></div>
                        <div class="text-center mt-2">
                           <button type="button" class="btn btn-xs btn-danger" onclick="stopScanner()">Stop Camera</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Warehouse</label>
                            <select name="warehouseId" id="adjWarehouse" class="form-select bg-black text-white border-secondary" required onchange="checkAdjWarehouseStock()">
                                <option value="">Select Warehouse</option>
                                @foreach (var w in Model.AllWarehouses)
                                {
                                    <option value="@w.WarehouseID">@w.WarehouseName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Adjustment Type</label>
                            <select name="type" class="form-select bg-black text-white border-secondary" required>
                                <option value="Damage">Damage</option>
                                <option value="Correction">Correction</option>
                                <option value="Write-off">Write-off</option>
                                <option value="Transfer Error">Transfer Error</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Quantity Change</label>
                            <input type="number" name="qty" class="form-control bg-black text-white border-secondary" placeholder="e.g. 5 or 10" required>
                            <div id="adjCurrentStock" class="small text-info mt-1"></div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label text-white-50 small">Reason / Note</label>
                        <textarea name="reason" rows="3" class="form-control bg-black text-white border-secondary" placeholder="Reason for adjustment..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" onclick="submitAdjustment()" class="btn btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        let html5QrcodeScanner = null;
        let currentScannerConfig = null;

        function startScanner(renderId, targetSelectId, statusId, startBtnId, stopBtnId, containerId) {
            currentScannerConfig = { renderId, targetSelectId, statusId, startBtnId, stopBtnId, containerId };
            const container = document.getElementById(containerId);
            const status = document.getElementById(statusId);

            container.style.display = 'block';
            status.innerHTML = '<span class="text-info">Starting scanner...</span>';

            if (html5QrcodeScanner) {
                html5QrcodeScanner.clear().then(() => initAndStart());
            } else {
                initAndStart();
            }

            function initAndStart() {
                html5QrcodeScanner = new Html5QrcodeScanner(
                    renderId, 
                    { fps: 20, qrbox: { width: 250, height: 250 }, aspectRatio: 1.0, supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA] },
                    false
                );
                html5QrcodeScanner.render((text) => onScanSuccess(text, targetSelectId, statusId), () => {});
            }
        }

        function onScanSuccess(decodedText, targetSelectId, statusId) {
            const cleanText = decodedText.trim();
            const targetSelect = document.getElementById(targetSelectId);
            const status = document.getElementById(statusId);
            
            if (matchVariantByBarcode(cleanText, targetSelect)) {
                status.innerHTML = `<span class="text-success fw-bold">Found: ${cleanText}</span>`;
                setTimeout(() => stopScanner(), 1000);
            } else {
                status.innerHTML = `<span class="text-warning">No match: ${cleanText}</span>`;
            }
        }

        function stopScanner() {
            if (html5QrcodeScanner && currentScannerConfig) {
                html5QrcodeScanner.clear().then(() => {
                    document.getElementById(currentScannerConfig.containerId).style.display = 'none';
                    document.getElementById(currentScannerConfig.statusId).innerHTML = '';
                    html5QrcodeScanner = null;
                }).catch(err => console.error(err));
            }
        }

        function matchVariantByBarcode(barcode, selectElement) {
            if (!barcode || !selectElement) return false;
            const search = barcode.trim().toUpperCase();
            for (let i = 0; i < selectElement.options.length; i++) {
                const opt = selectElement.options[i];
                if ((opt.dataset.barcode || "").toUpperCase() === search || opt.text.toUpperCase().includes(search)) {
                    selectElement.selectedIndex = i;
                    selectElement.dispatchEvent(new Event('change'));
                    return true;
                }
            }
            return false;
        }

        function checkAdjWarehouseStock() {
            const variantId = document.getElementById('adjVariant').value;
            const warehouseId = document.getElementById('adjWarehouse').value;
            const stockDiv = document.getElementById('adjCurrentStock');

            if (!variantId || !warehouseId) { stockDiv.innerHTML = ''; return; }

            stockDiv.innerHTML = 'Checking...';
            fetch(`/Test/GetWarehousesByVariant?variantId=${variantId}`)
                .then(res => res.json())
                .then(data => {
                    const found = data.find(w => w.warehouseID == warehouseId);
                    if (found) {
                        stockDiv.innerHTML = `<i class="bi bi-box-fill me-1"></i>Current Stock here: <strong>${found.quantityOnHand}</strong>`;
                    } else {
                        stockDiv.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>Not found in this warehouse. Target: 0`;
                    }
                });
        }

        function submitAdjustment() {
            const form = document.getElementById('requestAdjForm');
            const data = new FormData(form);
            const searchParams = new URLSearchParams();
            for (const pair of data) { searchParams.append(pair[0], pair[1]); }

            fetch('/Test/RequestAdjustment', {
                method: 'POST',
                body: searchParams
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    const err = document.getElementById('adjErrorMessage');
                    err.textContent = result.message || 'Error submitting request.';
                    err.classList.remove('d-none');
                }
            });
        }

        function approveAdjustment(id) {
            if (!confirm('Are you sure you want to approve this adjustment? Inventory stock will be updated immediately.')) return;
            
            const params = new URLSearchParams();
            params.append('id', id);

            fetch('/Test/ApproveAdjustment', {
                method: 'POST',
                body: params
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            });
        }

        function rejectAdjustment(id) {
            if (!confirm('Reject this adjustment request?')) return;

            const params = new URLSearchParams();
            params.append('id', id);

            fetch('/Test/RejectAdjustment', {
                method: 'POST',
                body: params
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            });
        }
    </script>
}
