@model ThrdCtrl2.Models.InventoryViewModel
@{
    ViewData["Title"] = "Inventory";
    Layout = "_LayoutDashboard";
}

<div class="dashboard">

    <!-- HEADER -->
    <div class="overview-header">
        <div>
            <h1>Inventory Management</h1>
            <p class="overview-sub">
                Track stock levels, variants, and warehouse distribution.
            </p>
        </div>

        <div class="overview-actions">
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addCategoryModal"><i class="bi bi-tag-fill"></i> New Category</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addWarehouseModal"><i class="bi bi-building-fill"></i> New Warehouse</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addVariantModal"><i class="bi bi-layers-half"></i> New Variant</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addItemModal"><i class="bi bi-plus-circle-dotted"></i> Add Item</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#transferStockModal"><i class="bi bi-suitcase-lg-fill"></i> Transfer Stock</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#stockAdjustmentModal"><i class="bi bi-wrench-adjustable"></i> Stock Adjustment</button>
            <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal"><i class="bi bi-plus-square-fill"></i> New Product</button>
        </div>
    </div>

    <!-- FILTER BAR -->
    <form method="get" asp-action="Inventory" class="filter-bar">

        <div class="filter-group">
            <label>Warehouse</label>
            <select name="warehouseId" class="filter-input">
                <option value="">All Warehouses</option>
                @if (Model.Warehouses != null)
                {
                    foreach (var w in Model.Warehouses)
                    {
                        <option value="@w.WarehouseID" selected="@(Model.SelectedWarehouseId == w.WarehouseID)">@w.WarehouseName</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Category</label>
            <select name="categoryId" class="filter-input">
                <option value="">All Categories</option>
                @if (Model.Categories != null)
                {
                    foreach (var c in Model.Categories)
                    {
                        <option value="@c.CategoryID" selected="@(Model.SelectedCategoryId == c.CategoryID)">@c.CategoryName</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Stock Status</label>
            <select name="status" class="filter-input">
                <option value="">All Statuses</option>
                <option value="In Stock" selected="@(Model.SelectedStatus == "In Stock")">In Stock</option>
                <option value="Low Stock" selected="@(Model.SelectedStatus == "Low Stock")">Low Stock</option>
                <option value="Out of Stock" selected="@(Model.SelectedStatus == "Out of Stock")">Out of Stock</option>
            </select>
        </div>

        <div class="filter-group mt-2">
            <button type="submit" class="btn-primary-small">Apply Filters</button>
        </div>
    </form>

    <!-- LOWER SECTION -->
    <div class="lower-grid-inv">
        <!-- INVENTORY TABLE -->
        <div class="table-card-big">
            <div class="table-header">
                <h3>Inventory Items</h3>
            </div>

            <div class="table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" /></th>
                            <th>Product Details</th>
                            <th>Warehouse</th>
                            <th>SKU</th>
                            <th>Quantity</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.InventoryItems != null && Model.InventoryItems.Any())
                        {
                            foreach (var item in Model.InventoryItems)
                            {
                                <tr>
                                    <td><input type="checkbox" /></td>
                                    <td class="product-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-dark border border-secondary rounded p-1" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-box-seam text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="product-name">@item.ProductName</div>
                                                <div class="sku">@item.VariantInfo</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.WarehouseName</td>
                                    <td><code class="text-white-50">@item.SKU</code></td>
                                    <td class="fw-bold">
                                        @if (item.InventoryID == 0)
                                        {
                                            <span class="text-white-50">N/A</span>
                                        }
                                        else
                                        {
                                            @item.QuantityOnHand
                                        }
                                    </td>
                                    <td>
                                        @if (item.InventoryID == 0)
                                        {
                                            <span class="status-blue" style="background: #e0f2fe; color: #0369a1 !important;">Pending Setup</span>
                                        }
                                        else if (item.QuantityOnHand <= 0)
                                        {
                                            <span class="status-red">Out of Stock</span>
                                        }
                                        else if (item.QuantityOnHand <= item.MinimumStockLevel)
                                        {
                                            <span class="status-blue">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="status-green">In Stock</span>
                                        }
                                    </td>
                                    <td>@item.LastUpdated.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-white-50">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No inventory items found. Click "New Product" to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <div>Showing @(Model.InventoryItems?.Count ?? 0) products</div>
                <div class="pagination">
                    <button class="page-btn">‹</button>
                    <button class="page-btn active">1</button>
                    <button class="page-btn">›</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD PRODUCT MODAL -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Add New Product</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddProduct" method="post">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-white-50 small">Product Name</label>
                            <input type="text" name="ProductName" class="form-control bg-black text-white border-secondary" required placeholder="e.g. Denim Jacket">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Category</label>
                            <select name="CategoryID" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Category</option>
                                @if (Model.Categories != null)
                                {
                                    foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.CategoryID">@c.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Initial Warehouse</label>
                            <select name="warehouseId" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Warehouse</option>
                                @if (Model.Warehouses != null)
                                {
                                    foreach (var w in Model.Warehouses)
                                    {
                                        <option value="@w.WarehouseID">@w.WarehouseName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small">SKU</label>
                            <input type="text" name="sku" class="form-control bg-black text-white border-secondary" placeholder="e.g. JKT-DENIM-001">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Color</label>
                            <input type="text" name="color" class="form-control bg-black text-white border-secondary" placeholder="e.g. Blue">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Size</label>
                            <input type="text" name="size" class="form-control bg-black text-white border-secondary" placeholder="e.g. XL">
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small">Description</label>
                            <textarea name="Description" class="form-control bg-black text-white border-secondary" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveSwitch">
                                <label class="form-check-label text-white-50 small" for="isActiveSwitch">Product is Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Product</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- STOCK ADJUSTMENT MODAL -->
<div class="modal fade" id="stockAdjustmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Stock Adjustment (Stock In)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateStock" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Inventory Item</label>
                        <select name="inventoryId" class="form-select bg-black text-white border-secondary" required>
                            <option value="">Select Item</option>
                            @if (Model.InventoryItems != null)
                            {
                                foreach (var item in Model.InventoryItems)
                                {
                                    <option value="@item.InventoryID">@item.ProductName (@item.VariantInfo)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Quantity to Add</label>
                        <input type="number" name="quantity" class="form-control bg-black text-white border-secondary" required min="1" value="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Reason / Reference</label>
                        <input type="text" name="reference" class="form-control bg-black text-white border-secondary" placeholder="e.g. Manual Adjustment">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add to Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD CATEGORY MODAL -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-primary"><i class="bi bi-tag-fill me-2"></i>New Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCategory" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Category Name</label>
                        <input type="text" name="CategoryName" class="form-control bg-black text-white border-secondary" required placeholder="e.g. Winter Wear">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Description</label>
                        <textarea name="Description" class="form-control bg-black text-white border-secondary" rows="2" placeholder="Briefly describe what this category includes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD WAREHOUSE MODAL -->
<div class="modal fade" id="addWarehouseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-success"><i class="bi bi-building-fill me-2"></i>New Warehouse</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddWarehouse" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Warehouse Name</label>
                        <input type="text" name="WarehouseName" class="form-control bg-black text-white border-secondary" required placeholder="e.g. Central Hub">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Location</label>
                        <input type="text" name="Location" class="form-control bg-black text-white border-secondary" placeholder="e.g. Downtown Sector 4">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create Warehouse</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD ITEM MODAL (Link Variant to Warehouse) -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-plus-circle-dotted me-2"></i>Add to Warehouse</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddInventoryItem" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Product / Variant</label>
                        <select name="variantId" class="form-select bg-black text-white border-secondary" required>
                            <option value="">Select Variant</option>
                            @if (Model.ProductVariants != null)
                            {
                                foreach (var v in Model.ProductVariants)
                                {
                                    <option value="@v.VariantID">@v.ProductName (@v.SKU - @v.Size / @v.Color)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Warehouse</label>
                        <select name="warehouseId" class="form-select bg-black text-white border-secondary" required>
                            <option value="">Select Warehouse</option>
                            @if (Model.Warehouses != null)
                            {
                                foreach (var w in Model.Warehouses)
                                {
                                    <option value="@w.WarehouseID">@w.WarehouseName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Minimum Stock Level</label>
                        <input type="number" name="minStock" class="form-control bg-black text-white border-secondary" required min="1" value="5">
                        <div class="form-text text-white-50 small">Alert if stock falls below this.</div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD VARIANT MODAL -->
<div class="modal fade" id="addVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-info"><i class="bi bi-layers-half me-2"></i>New Variant</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddVariant" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Product</label>
                        <select name="ProductID" class="form-select bg-black text-white border-secondary" required>
                            <option value="">Select Product...</option>
                            @if (Model.Products != null)
                            {
                                foreach (var p in Model.Products)
                                {
                                    <option value="@p.ProductID">@p.ProductName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Color</label>
                            <input type="text" name="Color" class="form-control bg-black text-white border-secondary" placeholder="e.g. Red" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Size</label>
                            <input type="text" name="Size" class="form-control bg-black text-white border-secondary" placeholder="e.g. Medium" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small">SKU</label>
                            <input type="text" name="SKU" class="form-control bg-black text-white border-secondary" placeholder="e.g. SHIRT-RED-MED">
                        </div>
                    </div>
                    <hr class="border-secondary my-3">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Assign to Warehouse (Optional)</label>
                        <select name="WarehouseID" class="form-select bg-black text-white border-secondary">
                            <option value="">Don't assign yet</option>
                            @if (Model.Warehouses != null)
                            {
                                foreach (var w in Model.Warehouses)
                                {
                                    <option value="@w.WarehouseID">@w.WarehouseName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Minimum Stock Level</label>
                        <input type="number" name="MinStock" class="form-control bg-black text-white border-secondary" value="5">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">Create Variant</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- TRANSFER STOCK MODAL -->
<div class="modal fade" id="transferStockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning"><i class="bi bi-suitcase-lg-fill me-2"></i>Transfer Stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="TransferStock" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Product / Variant</label>
                        <select name="variantId" class="form-select bg-black text-white border-secondary" required>
                            <option value="">Select Variant</option>
                            @if (Model.ProductVariants != null)
                            {
                                foreach (var v in Model.ProductVariants)
                                {
                                    <option value="@v.VariantID">@v.ProductName (@v.SKU - @v.Size / @v.Color)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">From Warehouse</label>
                            <select name="fromWarehouseId" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Source</option>
                                @if (Model.Warehouses != null)
                                {
                                    foreach (var w in Model.Warehouses)
                                    {
                                        <option value="@w.WarehouseID">@w.WarehouseName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">To Warehouse</label>
                            <select name="toWarehouseId" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Destination</option>
                                @if (Model.Warehouses != null)
                                {
                                    foreach (var w in Model.Warehouses)
                                    {
                                        <option value="@w.WarehouseID">@w.WarehouseName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label text-white-50 small">Quantity to Transfer</label>
                        <input type="number" name="quantity" class="form-control bg-black text-white border-secondary" required min="1" value="1">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Execute Transfer</button>
                </div>
            </form>
        </div>
    </div>
</div>
