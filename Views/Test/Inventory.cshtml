@model ThrdCtrl2.Models.InventoryViewModel
@{
    ViewData["Title"] = "Inventory";
    Layout = "_LayoutDashboard";
}

<div class="dashboard">

    <!-- HEADER -->
    <div class="overview-header">
        <div>
            <h1>Inventory Management</h1>
            <p class="overview-sub">
                Track stock levels, variants, and warehouse distribution.
            </p>
        </div>

        <div class="overview-actions">
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addCategoryModal"><i class="bi bi-tag-fill"></i> New Category</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addWarehouseModal"><i class="bi bi-building-fill"></i> New Warehouse</button>
            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#addVariantModal"><i class="bi bi-layers-half"></i> New Variant</button>

            <button class="btn-outline" data-bs-toggle="modal" data-bs-target="#transferStockModal"><i class="bi bi-suitcase-lg-fill"></i> Transfer Stock</button>
            <button class="btn-outline" onclick="window.open('/Test/PrintLabels', '_blank')"><i class="bi bi-printer-fill"></i> Print QRs</button>
            <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal"><i class="bi bi-plus-square-fill"></i> New Product</button>
        </div>
    </div>

    <!-- FILTER BAR -->
    <form method="get" asp-action="Inventory" class="filter-bar">

        <div class="filter-group">
            <label>Warehouse</label>
            <select name="warehouseId" class="filter-input">
                <option value="">All Warehouses</option>
                @if (Model.Warehouses != null)
                {
                    foreach (var w in Model.Warehouses)
                    {
                        <option value="@w.WarehouseID" selected="@(Model.SelectedWarehouseId == w.WarehouseID)">@w.WarehouseName</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Category</label>
            <select name="categoryId" class="filter-input">
                <option value="">All Categories</option>
                @if (Model.Categories != null)
                {
                    foreach (var c in Model.Categories)
                    {
                        <option value="@c.CategoryID" selected="@(Model.SelectedCategoryId == c.CategoryID)">@c.CategoryName</option>
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Stock Status</label>
            <select name="status" class="filter-input">
                <option value="">All Statuses</option>
                <option value="In Stock" selected="@(Model.SelectedStatus == "In Stock")">In Stock</option>
                <option value="Low Stock" selected="@(Model.SelectedStatus == "Low Stock")">Low Stock</option>
                <option value="Out of Stock" selected="@(Model.SelectedStatus == "Out of Stock")">Out of Stock</option>
            </select>
        </div>

        <div class="filter-group mt-2">
            <button type="submit" class="btn-primary-small">Apply Filters</button>
        </div>
    </form>

    <!-- LOWER SECTION -->
    <div class="lower-grid-inv">
        <!-- INVENTORY TABLE -->
        <div class="table-card-big">
            <div class="table-header">
                <h3>Inventory Items</h3>
            </div>

            <div class="table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Product Details</th>
                            <th>Warehouse</th>
                            <th>SKU</th>
                            <th class="text-center">Quantity</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.InventoryItems != null && Model.InventoryItems.Any())
                        {
                            int index = (Model.CurrentPage - 1) * Model.PageSize + 1;
                            foreach (var item in Model.InventoryItems)
                            {
                                <tr>
                                    <td class="text-white-50 small">@index</td>
                                    <td class="product-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-dark border border-secondary rounded p-1" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-box-seam text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="product-name">@item.ProductName</div>
                                                <div class="sku">@item.VariantInfo</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.WarehouseName</td>
                                    <td><code class="text-white-50">@item.SKU</code></td>
                                    <td class="fw-bold text-center">
                                        @item.QuantityOnHand
                                    </td>
                                    <td>
                                        @if (item.InventoryID == 0)
                                        {
                                            <span class="status-blue" style="background: #e0f2fe; color: #0369a1 !important;">Pending Setup</span>
                                        }
                                        else if (item.QuantityOnHand <= 0)
                                        {
                                            <span class="status-red">Out of Stock</span>
                                        }
                                        else if (item.QuantityOnHand <= item.MinimumStockLevel)
                                        {
                                            <span class="status-blue">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="status-green">In Stock</span>
                                        }
                                    </td>
                                    <td>@item.LastUpdated.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-info view-item-btn" 
                                                data-name="@item.ProductName" 
                                                data-variant="@item.VariantInfo" 
                                                data-warehouse="@item.WarehouseName" 
                                                data-sku="@item.SKU" 
                                                data-qty="@item.QuantityOnHand" 
                                                data-barcode="@item.Barcode">
                                            <i class="bi bi-eye"></i> View
                                        </button>
                                        @if (item.InventoryID > 0)
                                        {
                                            <button class="btn btn-sm btn-outline-warning edit-item-btn ms-1" 
                                                    data-id="@item.InventoryID"
                                                    data-name="@item.ProductName" 
                                                    data-variant="@item.VariantInfo" 
                                                    data-qty="@item.QuantityOnHand" 
                                                    data-min="@item.MinimumStockLevel"
                                                    data-price="@item.VariantPrice">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-white-50">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No inventory items found. Click "New Product" to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <div class="text-white-50 small">
                    Showing @(Model.TotalItems == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems entries
                </div>
                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-btn" href="@Url.Action("Inventory", new { page = Model.CurrentPage - 1, categoryId = Model.SelectedCategoryId, status = Model.SelectedStatus, warehouseId = Model.SelectedWarehouseId })">‹</a>
                    }
                    else
                    {
                        <button class="page-btn disabled" disabled>‹</button>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <button class="page-btn active">@i</button>
                        }
                        else
                        {
                            <a class="page-btn" href="@Url.Action("Inventory", new { page = i, categoryId = Model.SelectedCategoryId, status = Model.SelectedStatus, warehouseId = Model.SelectedWarehouseId })">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-btn" href="@Url.Action("Inventory", new { page = Model.CurrentPage + 1, categoryId = Model.SelectedCategoryId, status = Model.SelectedStatus, warehouseId = Model.SelectedWarehouseId })">›</a>
                    }
                    else
                    {
                        <button class="page-btn disabled" disabled>›</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD PRODUCT MODAL -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Add New Product</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddProduct" method="post">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-white-50 small">Product Name</label>
                            <input type="text" name="ProductName" class="form-control bg-black text-white border-secondary" required placeholder="e.g. Denim Jacket">
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small">Category</label>
                            <select name="CategoryID" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Category</option>
                                @if (Model.Categories != null)
                                {
                                    foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.CategoryID">@c.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-white-50 small">Description</label>
                            <textarea name="Description" class="form-control bg-black text-white border-secondary" rows="3" placeholder="Brief details about the product..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveSwitch">
                                <label class="form-check-label text-white-50 small" for="isActiveSwitch">Product is Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Product</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- ADD CATEGORY MODAL -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-primary"><i class="bi bi-tag-fill me-2"></i>New Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCategory" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Category Name</label>
                        <input type="text" name="CategoryName" class="form-control bg-black text-white border-secondary" required placeholder="e.g. Winter Wear">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Description</label>
                        <textarea name="Description" class="form-control bg-black text-white border-secondary" rows="2" placeholder="Briefly describe what this category includes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD WAREHOUSE MODAL -->
<div class="modal fade" id="addWarehouseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-success"><i class="bi bi-building-fill me-2"></i>New Warehouse</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddWarehouse" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Warehouse Name</label>
                        <input type="text" name="WarehouseName" class="form-control bg-black text-white border-secondary" required placeholder="e.g. Central Hub">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Location</label>
                        <input type="text" name="Location" class="form-control bg-black text-white border-secondary" placeholder="e.g. Downtown Sector 4">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create Warehouse</button>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- ADD VARIANT MODAL -->
<div class="modal fade" id="addVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-info"><i class="bi bi-layers-half me-2"></i>New Variant</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddVariant" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Product</label>
                        <select name="ProductID" class="form-select bg-black text-white border-secondary" required>
                            <option value="">Select Product...</option>
                            @if (Model.Products != null)
                            {
                                foreach (var p in Model.Products)
                                {
                                    <option value="@p.ProductID">@p.ProductName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Color</label>
                            <input type="text" name="Color" class="form-control bg-black text-white border-secondary" placeholder="e.g. Red" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Size</label>
                            <input type="text" name="Size" class="form-control bg-black text-white border-secondary" placeholder="e.g. Medium" required>
                        </div>
                        @* Automated SKU Generation *@
                        <input type="hidden" name="SKU" value="">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">Create Variant</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- TRANSFER STOCK MODAL -->
<div class="modal fade" id="transferStockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning"><i class="bi bi-suitcase-lg-fill me-2"></i>Transfer Stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="TransferStock" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Select Product / Variant</label>
                        <select name="variantId" id="transferVariant" class="form-select bg-black text-white border-secondary" required onchange="checkExistingWarehousesForTransfer()">
                            <option value="">Select Variant</option>
                            @if (Model.ProductVariants != null)
                            {
                                foreach (var v in Model.ProductVariants)
                                {
                                    <option value="@v.VariantID" data-barcode="@v.Barcode">@v.ProductName (@v.SKU - @v.Size / @v.Color)</option>
                                }
                            }
                        </select>
                        <div class="mt-2 d-flex gap-2 align-items-center">
                            <button type="button" class="btn btn-sm btn-outline-warning" id="startTransferScanBtn">
                                <i class="bi bi-qr-code-scan me-1"></i> Scan QR Code
                            </button>
                            <span id="transferScanStatus" class="text-white-50 small"></span>
                        </div>
                        <div id="transferBarcodeReaderContainer" style="display: none;" class="mt-2 border border-secondary rounded overflow-hidden">
                            <div id="transferReader" style="width: 100%; min-height: 250px;"></div>
                            <div class="p-2 bg-black text-center">
                                <button type="button" class="btn btn-xs btn-danger" id="stopTransferScanBtn">Stop Camera</button>
                            </div>
                        </div>
                        <div id="transferStockInfo" class="mt-2 text-primary small fw-semibold"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">From Warehouse</label>
                            <select name="fromWarehouseId" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Source</option>
                                @if (Model.Warehouses != null)
                                {
                                    foreach (var w in Model.Warehouses)
                                    {
                                        <option value="@w.WarehouseID">@w.WarehouseName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">To Warehouse</label>
                            <select name="toWarehouseId" class="form-select bg-black text-white border-secondary" required>
                                <option value="">Select Destination</option>
                                @if (Model.Warehouses != null)
                                {
                                    foreach (var w in Model.Warehouses)
                                    {
                                        <option value="@w.WarehouseID">@w.WarehouseName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label text-white-50 small">Quantity to Transfer</label>
                        <input type="number" name="quantity" class="form-control bg-black text-white border-secondary" required min="1" value="1">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Execute Transfer</button>
                </div>
            </form>
        </div>
    </div>
</div>


    <!-- View Item Modal -->
    <div class="modal fade" id="viewItemModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-info-circle me-2 text-info"></i>Item Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <div class="bg-black border border-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 80px; height: 80px;">
                            <i class="bi bi-box-seam text-info fs-1"></i>
                        </div>
                        <h4 id="viewItemName" class="mb-0">Product Name</h4>
                        <p id="viewItemVariant" class="text-white-50 small">Variant Info</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="text-white-50 small d-block">Warehouse</label>
                            <span id="viewItemWarehouse" class="fw-bold">Warehouse Name</span>
                        </div>
                        <div class="col-6">
                            <label class="text-white-50 small d-block">Quantity</label>
                            <span id="viewItemQty" class="fw-bold">0</span>
                        </div>
                        <div class="col-12">
                            <label class="text-white-50 small d-block">SKU</label>
                            <code id="viewItemSKU" class="text-info">SKU-CODE-123</code>
                        </div>
                        <div class="col-12">
                            <label class="text-white-50 small d-block">QR Identification</label>
                            <div class="mt-2 text-center">
                                <div class="bg-white p-3 d-inline-block rounded shadow-sm">
                                    <img id="viewItemBarcodeImg" src="" alt="QR Code" class="img-fluid" style="max-height: 180px;">
                                </div>
                                <div id="viewItemBarcode" class="mt-2 fs-5 fw-bold tracking-widest text-white">SKU-CODE</div>
                                <div class="text-white-50 small mt-1"><i class="bi bi-qr-code me-1"></i> Scan this with your phone</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Item Modal -->
    <div class="modal fade" id="editItemModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Item Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <h6 id="editItemName" class="text-white">Product Name</h6>
                        <p id="editItemVariant" class="text-white-50 small mb-0">Variant Info</p>
                    </div>
                    <form id="editItemForm">
                        <input type="hidden" id="editInventoryId" name="inventoryId" value="" />
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Quantity on Hand</label>
                            <input type="number" id="editQty" name="quantity" class="form-control bg-black text-white border-secondary text-muted" readonly disabled>
                            <div class="form-text text-info small">Stock can only be added through Procurement or formal Stock Adjustments.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Minimum Stock Level</label>
                            <input type="number" id="editMinStock" name="minStock" class="form-control bg-black text-white border-secondary" required min="0">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small">Price (₱)</label>
                            <input type="number" id="editPrice" name="price" class="form-control bg-black text-white border-secondary" step="0.01" min="0">
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" onclick="saveItemEdits()">Save Changes</button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // View Item Details Handler
            const viewModalElem = document.getElementById('viewItemModal');
            const viewModal = new bootstrap.Modal(viewModalElem);
            
            document.addEventListener('click', function(e) {
                if (e.target.closest('.view-item-btn')) {
                    const btn = e.target.closest('.view-item-btn');
                    document.getElementById('viewItemName').textContent = btn.dataset.name;
                    document.getElementById('viewItemVariant').textContent = btn.dataset.variant;
                    document.getElementById('viewItemWarehouse').textContent = btn.dataset.warehouse;
                    document.getElementById('viewItemQty').textContent = btn.dataset.qty;
                    document.getElementById('viewItemSKU').textContent = btn.dataset.sku;
                    document.getElementById('viewItemBarcode').textContent = btn.dataset.barcode || 'N/A';
                    
                    const barcodeImg = document.getElementById('viewItemBarcodeImg');
                    if (btn.dataset.sku) {
                        barcodeImg.src = `/Test/GetBarcodeImage?sku=${encodeURIComponent(btn.dataset.sku)}`;
                        barcodeImg.style.display = 'inline-block';
                    } else {
                        barcodeImg.style.display = 'none';
                    }
                    
                    viewModal.show();
                }
                
                if (e.target.closest('.edit-item-btn')) {
                    const btn = e.target.closest('.edit-item-btn');
                    document.getElementById('editInventoryId').value = btn.dataset.id;
                    document.getElementById('editItemName').textContent = btn.dataset.name;
                    document.getElementById('editItemVariant').textContent = btn.dataset.variant;
                    document.getElementById('editQty').value = btn.dataset.qty;
                    document.getElementById('editMinStock').value = btn.dataset.min;
                    document.getElementById('editPrice').value = btn.dataset.price;
                    
                    const editModalElem = document.getElementById('editItemModal');
                    const editModal = new bootstrap.Modal(editModalElem);
                    editModal.show();
                }
            });

            // QR Scanner Logic
            let html5QrcodeScanner = null;
            let currentScannerConfig = null;

            function startScanner(renderId, targetSelectId, statusId, startBtnId, stopBtnId, containerId) {
                currentScannerConfig = { renderId, targetSelectId, statusId, startBtnId, stopBtnId, containerId };
                const container = document.getElementById(containerId);
                const status = document.getElementById(statusId);
                const startBtn = document.getElementById(startBtnId);
                const stopBtn = document.getElementById(stopBtnId);

                container.style.display = 'block';
                status.innerHTML = '<span class="text-info">Starting scanner...</span>';

                if (html5QrcodeScanner) {
                    html5QrcodeScanner.clear().then(() => initAndStart());
                } else {
                    initAndStart();
                }

                function initAndStart() {
                    html5QrcodeScanner = new Html5QrcodeScanner(
                        renderId, 
                        { 
                            fps: 20, 
                            qrbox: { width: 300, height: 300 },
                            aspectRatio: 1.0,
                            rememberLastUsedCamera: true,
                            showTorchButtonIfSupported: true,
                            supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA]
                        },
                        false
                    );
                    html5QrcodeScanner.render((text) => onScanSuccess(text, targetSelectId, statusId), onScanFailure);
                    startBtn.style.display = 'none';
                    stopBtn.style.display = 'inline-block';
                }
            }

            function onScanSuccess(decodedText, targetSelectId, statusId) {
                console.log(`Scan Result: ${decodedText}`);
                const cleanText = decodedText.trim();
                const targetSelect = document.getElementById(targetSelectId);
                const status = document.getElementById(statusId);
                
                if (matchVariantByBarcode(cleanText, targetSelect)) {
                    status.innerHTML = `<div class="alert alert-success p-2 mb-0 mt-2 animate__animated animate__pulse"><i class="bi bi-check-circle-fill me-2"></i><strong>Auto-Selected:</strong> ${cleanText}</div>`;
                    if (navigator.vibrate) navigator.vibrate(100);
                    setTimeout(() => stopScanner(), 1200);
                } else {
                    status.innerHTML = `<div class="alert alert-warning p-2 mb-0 mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>No match in list for: ${cleanText}</div>`;
                }
            }

            function onScanFailure(error) { /* Background noise */ }

            function stopScanner() {
                if (html5QrcodeScanner && currentScannerConfig) {
                    const config = currentScannerConfig;
                    html5QrcodeScanner.clear().then(() => {
                        document.getElementById(config.containerId).style.display = 'none';
                        document.getElementById(config.startBtnId).style.display = 'inline-block';
                        document.getElementById(config.stopBtnId).style.display = 'none';
                        document.getElementById(config.statusId).innerHTML = '';
                        html5QrcodeScanner = null;
                        currentScannerConfig = null;
                    }).catch(err => {
                        console.error("Stop error:", err);
                        document.getElementById(config.containerId).style.display = 'none';
                    });
                }
            }

            function matchVariantByBarcode(barcode, selectElement) {
                if (!barcode || !selectElement) return false;
                const search = barcode.trim().toUpperCase();
                for (let i = 0; i < selectElement.options.length; i++) {
                    const option = selectElement.options[i];
                    const optBarcode = (option.dataset.barcode || "").trim().toUpperCase();
                    const optText = option.text.toUpperCase();
                    if (optBarcode === search || optText.includes(search)) {
                        selectElement.selectedIndex = i;
                        selectElement.dispatchEvent(new Event('change'));
                        return true;
                    }
                }
                return false;
            }

            // Bind Event Listeners


            document.getElementById('startTransferScanBtn').addEventListener('click', () => 
                startScanner('transferReader', 'transferVariant', 'transferScanStatus', 'startTransferScanBtn', 'stopTransferScanBtn', 'transferBarcodeReaderContainer'));
            
            document.getElementById('stopTransferScanBtn').addEventListener('click', stopScanner);

            // Stop scanner when modals are closed

            document.getElementById('transferStockModal').addEventListener('hidden.bs.modal', stopScanner);
        });



        function checkExistingWarehousesForTransfer() {
            const variantId = document.getElementById('transferVariant').value;
            const infoDiv = document.getElementById('transferStockInfo');
            fetchWarehouseStock(variantId, infoDiv);
        }

        function fetchWarehouseStock(variantId, infoDiv) {
            if (!variantId) {
                infoDiv.innerHTML = '';
                return;
            }

            infoDiv.innerHTML = '<span class="spinner-border spinner-border-sm text-primary" role="status"></span> Checking existing stock...';

            fetch(`/Test/GetWarehousesByVariant?variantId=${variantId}`)
                .then(response => response.json())
                .then(data => {
                    infoDiv.className = 'mt-2 text-primary small fw-semibold';
                    if (data.length === 0) {
                        infoDiv.innerHTML = '<i class="bi bi-info-circle me-1"></i>Out of Stock / Never assigned to any warehouse.';
                    } else {
                        let html = '<i class="bi bi-box-seam me-1"></i>Current Stock:<br>';
                        data.forEach(w => {
                            html += `<span class="badge bg-secondary me-1">${w.warehouseName}: ${w.quantityOnHand}</span>`;
                        });
                        infoDiv.innerHTML = html;
                    }
                })
                .catch(err => {
                    console.error('Error fetching warehouse info:', err);
                    infoDiv.textContent = 'Error checking warehouses.';
                });
        }

        function saveItemEdits() {
            const inventoryId = document.getElementById('editInventoryId').value;
            const quantity = document.getElementById('editQty').value;
            const minStock = document.getElementById('editMinStock').value;
            const price = document.getElementById('editPrice').value;

            fetch('/Test/UpdateInventoryItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `inventoryId=${inventoryId}&minStock=${minStock}&price=${price}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating item.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Error updating item.');
            });
        }
    </script>
}
