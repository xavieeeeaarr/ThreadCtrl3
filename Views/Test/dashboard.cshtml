@model ThrdCtrl2.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
    Layout = "_LayoutDashboard";
}

<style>
    :root {
        --dash-bg: #131211;
        --card-bg: #1a1a1a; /* Matching top-bar precisely */
        --card-hover: #1f1f1e;
        --border-color: #333333;
        --text-main: #ffffff;
        --text-muted: #aaaaaa;
        --accent-brand: #a7d417; /* Signature Lime Green */
        --accent-blue: #3b82f6;
        --accent-red: #ef4444;
        --accent-orange: #f59e0b;
    }

    .dashboard {
        padding: 24px;
        background: var(--dash-bg);
        min-height: 100vh;
        color: var(--text-main);
    }

    .text-muted {
        color: var(--text-muted) !important;
    }

    .header-pagination {
        display: flex;
        align-items: center;
    }

    .header-pagination .btn-outline-secondary {
        border-color: #444;
        color: #888;
    }

    .header-pagination .btn-outline-secondary:hover:not(.disabled) {
        background: #333;
        color: #fff;
        border-color: #666;
    }

    .header-pagination .disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .overview-header h1 {
        font-size: 1.85rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 4px;
    }

    .overview-sub {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    /* CARDS */
    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 32px;
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        position: relative;
        transition: all 0.25s ease-out;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        background: var(--card-hover);
        border-color: #444;
        box-shadow: 0 12px 24px rgba(0,0,0,0.3);
    }

    .stat-icon {
        position: absolute;
        top: 24px;
        right: 24px;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
    }

    .icon-brand { color: var(--accent-brand); }
    .icon-red { color: var(--accent-red); }
    .icon-blue { color: var(--accent-blue); }
    .icon-yellow { color: var(--accent-orange); }

    .stat-card .label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 12px;
        display: block;
        font-weight: 700;
    }

    .stat-card .value {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .stat-card .sub-label {
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* GRID SECTIONS */
    .middle-grid {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 24px;
        margin-top: 24px;
    }

    .content-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 28px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .card-header h3 {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    /* ACTIVITY FEED */
    .activity-feed {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .activity-item {
        display: grid;
        grid-template-columns: 44px 1fr 80px;
        gap: 16px;
        align-items: center;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        background: #2a2a2a;
        color: var(--text-main);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        border: 1px solid var(--border-color);
    }

    .activity-item .module-pill {
        font-size: 0.7rem;
        padding: 2px 10px;
        border-radius: 6px;
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 4px;
        display: inline-block;
    }

    .activity-item .action {
        font-size: 0.95rem;
        margin: 0;
        color: #ddd;
    }

    .activity-item .action span {
        font-weight: 700;
        color: var(--accent-brand);
    }

    .activity-item .time {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-align: right;
    }

    /* APPROVAL TABLE */
    .approval-section {
        margin-top: 24px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        text-align: left;
        padding: 14px 16px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border-bottom: 2px solid var(--dash-bg);
    }

    .data-table td {
        padding: 18px 16px;
        font-size: 0.95rem;
        border-bottom: 1px solid #222;
    }

    .badge-type {
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 700;
        border: 1px solid transparent;
    }

    .badge-damage { background: rgba(239, 68, 68, 0.1); color: #f87171; border-color: rgba(239, 68, 68, 0.2); }
    .badge-correction { background: rgba(167, 212, 23, 0.1); color: #a7d417; border-color: rgba(167, 212, 23, 0.2); }

    .value-neg { color: #f87171; font-weight: 700; }
    .value-pos { color: var(--accent-brand); font-weight: 700; }

    .btn-approve {
        background: var(--accent-brand);
        color: #131211;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s, background 0.2s;
    }

    .btn-approve:hover { 
        background: #b8e61a;
        transform: scale(1.05);
    }

    .btn-reject {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        margin-right: 8px;
        transition: all 0.2s;
    }

    .btn-reject:hover { 
        color: white;
        background: rgba(239, 68, 68, 0.1);
        border-color: var(--accent-red);
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="overview-header d-flex justify-content-between align-items-end">
        <div>
            <h1>Dashboard Overview</h1>
            <p class="overview-sub">
                Enterprise-grade inventory intelligence and operation status.
            </p>
        </div>
        <div>
            <a href="@Url.Action("DashboardReport", "Test")" target="_blank" class="btn btn-outline-light btn-sm px-3 rounded-pill"><i class="bi bi-file-earmark-pdf me-2"></i>Export PDF</a>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="dashboard-cards">
        
        <div class="stat-card">
            <div class="stat-icon icon-brand">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <span class="label">Inventory Valuation</span>
            <div class="value">₱@Model.TotalInventoryValue.ToString("N0")</div>
            <div class="sub-label" style="color: var(--accent-brand)">
                <i class="bi bi-activity me-1"></i> Market stable (+2.4%)
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-red">
                <i class="bi bi-exclamation-square"></i>
            </div>
            <span class="label">Alerts & Low Stock</span>
            <div class="value">@Model.LowStockItemsCount</div>
            <div class="sub-label" style="color: var(--accent-red)">
                Critical replenish required
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <i class="bi bi-cart4"></i>
            </div>
            <span class="label">Active Orders</span>
            <div class="value">@Model.ActiveSalesOrdersCount</div>
            <div class="sub-label" style="color: var(--accent-blue)">
                <i class="bi bi-lightning-charge-fill me-1"></i> High volume detected
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-yellow">
                <i class="bi bi-shield-lock"></i>
            </div>
            <span class="label">Pending Review</span>
            <div class="value">@Model.PendingAdjustmentsCount</div>
            <div class="sub-label" style="color: var(--accent-orange)">
                Admin authorization needed
            </div>
        </div>

    </div>

    <!-- MIDDLE SECTION -->
    <div class="middle-grid">
        
        <!-- CHART -->
        <div class="content-card">
            <div class="card-header">
                <h3>Asset Trend Distribution</h3>
                <span class="badge border border-secondary text-white-50 px-3 py-1 rounded-pill" style="font-size: 0.7rem; letter-spacing: 0.05em;">H1 2026</span>
            </div>
            <div style="height: 320px; position: relative;">
                <canvas id="valuationTrendChart"></canvas>
            </div>
        </div>

        <!-- RECENT ACTIVITY -->
        <div class="content-card">
            <div class="card-header">
                <h3>Global Audit Log</h3>
                <a href="#" class="text-white-50 small fw-bold text-decoration-none hover-white">ARCHIVE</a>
            </div>
            <div class="activity-feed">
                @if (!Model.RecentActivity.Any())
                {
                    <p class="text-center text-muted py-5">System state is idle.</p>
                }
                @foreach (var log in Model.RecentActivity)
                {
                    var initials = string.Concat(log.UserFullName?.Split(' ').Select(x => x[0]) ?? new[] { 'S' });
                    <div class="activity-item">
                        <div class="user-avatar">@initials</div>
                        <div>
                            <span class="module-pill">@log.Module</span>
                            <p class="action">@log.UserFullName <span>@log.Action</span></p>
                        </div>
                        <div class="time">
                            @{
                                var diff = DateTime.Now - log.Timestamp;
                                if (diff.TotalMinutes < 1) @("Now")
                                else if (diff.TotalMinutes < 60) @((int)diff.TotalMinutes + "m ago")
                                else if (diff.TotalHours < 24) @((int)diff.TotalHours + "h ago")
                                else @((int)diff.TotalDays + "d ago")
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- BOTTOM SECTION: APPROVALS -->
    <div class="content-card approval-section">
        <div class="card-header">
            <h3>Authorization Requests</h3>
            <div class="header-pagination">
                <span class="text-muted small me-3">Page @Model.CurrentPage of @Model.TotalPages</span>
                <div class="btn-group">
                    <a href="@Url.Action("Dashboard", new { page = Model.CurrentPage - 1 })" 
                       class="btn btn-sm btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <a href="@Url.Action("Dashboard", new { page = Model.CurrentPage + 1 })" 
                       class="btn btn-sm btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Adjustment #</th>
                        <th>Originator</th>
                        <th>Category</th>
                        <th>Associated Product</th>
                        <th>Units</th>
                        <th>Timestamp</th>
                        <th class="text-end">Validation</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PendingAdjustments.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-white-50">Operational cycle complete. No pending requests.</td></tr>
                    }
                    @foreach (var adj in Model.PendingAdjustments)
                    {
                        <tr>
                            <td class="fw-bold" style="color: var(--accent-brand)">#REQ-@adj.AdjustmentID.ToString("D4")</td>
                            <td>@adj.RequestedByName</td>
                            <td>
                                <span class="badge-type @(adj.Type == "Damage" ? "badge-damage" : "badge-correction")">
                                    @adj.Type
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold">@adj.ProductName</div>
                                <div class="text-muted small">@adj.VariantInfo</div>
                            </td>
                            <td class="@(adj.ChangeQuantity < 0 ? "value-neg" : "value-pos")">
                                @(adj.ChangeQuantity >= 0 ? "+" : "")@adj.ChangeQuantity
                            </td>
                            <td class="text-white-50">@adj.DateRequested.ToString("MMM dd, hh:mm tt")</td>
                            <td class="text-end">
                                <form asp-action="RejectAdjustment" asp-controller="Test" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@adj.AdjustmentID" />
                                    <button type="submit" class="btn-reject">REJECT</button>
                                </form>
                                <form asp-action="ApproveAdjustment" asp-controller="Test" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@adj.AdjustmentID" />
                                    <button type="submit" class="btn-approve">APPROVE</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            const ctx = document.getElementById('valuationTrendChart').getContext('2d');
            
            const labels = @Html.Raw(Json.Serialize(Model.ValuationTrend.Select(x => x.Month)));
            const data = @Html.Raw(Json.Serialize(Model.ValuationTrend.Select(x => x.Value)));

            const gradient = ctx.createLinearGradient(0, 0, 0, 320);
            gradient.addColorStop(0, 'rgba(167, 212, 23, 0.15)');
            gradient.addColorStop(1, 'rgba(167, 212, 23, 0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Valuation',
                        data: data,
                        borderColor: '#a7d417',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#a7d417',
                        pointBorderColor: '#1a1a1a',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.45,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1a1a1a',
                            titleColor: '#888',
                            bodyColor: '#a7d417',
                            borderColor: '#333',
                            borderWidth: 1,
                            padding: 14,
                            cornerRadius: 10,
                            displayColors: false,
                            titleFont: { size: 10, weight: '700' },
                            bodyFont: { size: 14, weight: '800' },
                            callbacks: {
                                label: function(context) {
                                    return ' ₱' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            border: { display: false },
                            ticks: { 
                                color: '#94a3b8',
                                font: { size: 10, weight: '600' },
                                padding: 10,
                                callback: function(value) {
                                    if (value >= 1000000) return '₱' + (value/1000000).toFixed(1) + 'M';
                                    if (value >= 1000) return '₱' + (value/1000) + 'k';
                                    return '₱' + value;
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { color: '#94a3b8', font: { size: 10, weight: '600' }, padding: 10 }
                        }
                    }
                }
            });
        });
    </script>
}
