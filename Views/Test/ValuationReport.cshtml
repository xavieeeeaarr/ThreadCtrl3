@model ThrdCtrl2.Models.ReportViewModel
@{
    Layout = null;
    var companyName = ViewData["CompanyName"] as string ?? "ThreadCtrl Enterprise";
    var reportDate = ViewData["ReportDate"] as string ?? DateTime.Now.ToString("MMMM dd, yyyy");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Valuation Report - @companyName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; margin: 0; background: #fff !important; color: #000 !important; }
            .report-container { box-shadow: none !important; border: none !important; margin: 0 !important; width: 100% !important; }
            .chart-container { page-break-inside: avoid; }
            .page-break { page-break-before: always; }
        }

        body {
            background-color: #f4f4f4;
            color: #333;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 40px 0;
        }

        .report-container {
            background: #fff;
            max-width: 1100px;
            margin: 0 auto;
            padding: 50px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            border: 1px solid #ddd;
        }

        .report-header {
            border-bottom: 2px solid #a7d417;
            padding-bottom: 20px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .company-info h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            color: #1a1a1a;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .report-title {
            text-align: right;
        }

        .report-title h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 300;
            color: #888;
        }

        .report-meta {
            font-size: 13px;
            color: #666;
            margin-top: 5px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 20px;
            border-left: 4px solid #a7d417;
            padding-left: 15px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 40px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-box {
            padding: 15px;
            background: #fcfcfc;
            border: 1px solid #eee;
            border-radius: 4px;
        }

        .stat-label {
            font-size: 10px;
            color: #999;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 18px;
            font-weight: 700;
            color: #131211;
        }

        .charts-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        .chart-box {
            border: 1px solid #eee;
            padding: 15px;
            border-radius: 4px;
        }

        .table-report {
            width: 100%;
            margin-bottom: 30px;
            border-collapse: collapse;
        }

        .table-report th {
            background: #f8f8f8;
            color: #333;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 10px;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        .table-report td {
            padding: 10px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 12px;
            vertical-align: top;
        }

        .table-report tr:nth-child(even) {
            background-color: #fafafa;
        }

        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            font-size: 10px;
            color: #999;
            text-align: center;
        }

        .btn-print-trigger {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #a7d417;
            color: #131211;
            border: none;
            padding: 15px 25px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            cursor: pointer;
            z-index: 100;
        }

        .btn-print-trigger:hover {
            background: #b8e61a;
            transform: translateY(-2px);
        }

        .positive { color: #2e7d32; }
        .negative { color: #d32f2f; }
        .text-end { text-align: right !important; }
    </style>
</head>
<body>

    <button class="btn-print-trigger no-print" onclick="window.print()">
        <i class="bi bi-printer-fill me-2"></i>CONFIRM PRINT
    </button>

    <div class="report-container">
        <!-- HEADER -->
        <header class="report-header">
            <div class="company-info">
                <h1>@companyName</h1>
                <div class="report-meta">Valuation Analysis & Asset Tracking</div>
            </div>
            <div class="report-title">
                <h2>INVENTORY VALUATION REPORT</h2>
                <div class="report-meta">Generated on @reportDate</div>
            </div>
        </header>

        <!-- KPI SUMMARY -->
        <section>
            <div class="section-title">Valuation Summary</div>
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-label">Total Asset Value</div>
                    <div class="stat-value">₱@Model.Valuation.TotalAssetValue.ToString("N0")</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Avg. Unit Cost</div>
                    <div class="stat-value">₱@Model.Valuation.AvgUnitCost.ToString("N2")</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Total Active SKUs</div>
                    <div class="stat-value">@Model.Valuation.TotalSKUs</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Top Category</div>
                    <div class="stat-value">@Model.Valuation.TopCategoryName</div>
                </div>
            </div>
        </section>

        <!-- VISUAL ANALYSIS -->
        <section class="charts-container no-print">
            <div class="chart-box">
                <div class="stat-label" style="margin-bottom: 10px;">Valuation Trend (12 Months)</div>
                <div style="height: 200px;">
                    <canvas id="historyChart"></canvas>
                </div>
            </div>
            <div class="chart-box">
                <div class="stat-label" style="margin-bottom: 10px;">Category Distribution</div>
                <div style="height: 200px;">
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </section>

        <!-- DETAILED TABLE -->
        <section>
            <div class="section-title">Detailed Asset Valuation</div>
            <table class="table-report">
                <thead>
                    <tr>
                        <th>Product / SKU</th>
                        <th>Category</th>
                        <th>Warehouse</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Total Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DetailedValuation)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold" style="font-weight: 700;">@item.ProductName</div>
                                <div style="font-size: 10px; color: #888;">@item.SKU</div>
                            </td>
                            <td>@item.Category</td>
                            <td>@item.Warehouse</td>
                            <td class="text-center">@item.QtyOnHand.ToString("N0")</td>
                            <td class="text-end">₱@item.UnitCost.ToString("N2")</td>
                            <td class="text-end" style="font-weight: 700;">₱@item.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <div class="page-break"></div>

        <!-- RECENT MOVEMENTS -->
        <section>
            <div class="section-title">Recent Stock Movements</div>
            <table class="table-report">
                <thead>
                    <tr>
                        <th>Trans ID</th>
                        <th>Type</th>
                        <th>Product Variant</th>
                        <th class="text-end">Qty Change</th>
                        <th>Timestamp</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.RecentMovements)
                    {
                        <tr>
                            <td>#@m.TransactionID</td>
                            <td>@m.Type</td>
                            <td>@m.ProductVariant</td>
                            <td class="text-end @(m.Quantity >= 0 ? "positive" : "negative")">
                                @(m.Quantity >= 0 ? "+" + m.Quantity : m.Quantity.ToString())
                            </td>
                            <td>@m.Date.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@m.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <footer class="footer">
            <p>Confidential Business Intelligence Document</p>
            <p>System Generated by Antigravity ThreadCtrl Engine &copy; @DateTime.Now.Year @companyName. All rights reserved.</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // History Chart
            const histCtx = document.getElementById('historyChart').getContext('2d');
            new Chart(histCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.ValuationHistory.Select(x => x.Month))),
                    datasets: [{
                        label: 'Valuation',
                        data: @Html.Raw(Json.Serialize(Model.ValuationHistory.Select(x => x.Value))),
                        backgroundColor: '#a7d417',
                        borderRadius: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, animation: false,
                    plugins: { legend: { display: false } },
                    scales: { 
                        y: { ticks: { font: { size: 9 } } },
                        x: { ticks: { font: { size: 9 } } }
                    }
                }
            });

            // Pie Chart
            const pieCtx = document.getElementById('pieChart').getContext('2d');
            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(x => x.CategoryName))),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.CategoryDistribution.Select(x => x.Value))),
                        backgroundColor: ['#004d40', '#00796b', '#26a69a', '#80cbc4', '#b2dfdb'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, animation: false,
                    plugins: { 
                        legend: { 
                            position: 'bottom',
                            labels: { boxWidth: 10, font: { size: 8 } }
                        } 
                    }
                }
            });
        });
    </script>
</body>
</html>
