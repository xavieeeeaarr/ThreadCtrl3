@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LayoutDashboard";
}

<div class="dashboard">
    <div class="card p-5 text-center mt-5">
        <div class="mb-4">
            <i class="bi bi-shield-slash-fill text-danger" style="font-size: 5rem;"></i>
        </div>
        <h1 class="text-danger fw-bold">Access Denied</h1>
        <p class="lead text-white-50">
            You do not have permission to view this page. This event has been logged for security purposes.
        </p>
        <div class="mt-4">
            <a href="@Url.Action("Dashboard", "Test")" class="btn-primary-small text-decoration-none">Return to Dashboard</a>
        </div>
    </div>
</div>
