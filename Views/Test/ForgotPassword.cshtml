@{
    ViewData["Title"] = "Forgot Password";
}

<div class="page-wrapper">
    <div class="reg-container">
        <div class="reg-card">
            <div class="logo-area">
                <div class="logo-icon">
                    <img src="~/images/icon.png" alt="Logo" />
                </div>
                <div class="system-name">Recovery</div>
                <div class="subtitle">Enter your email to receive a password reset link</div>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success">@ViewBag.Message</div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
                    <label class="form-label-black">Email Address</label>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Send Reset Link</button>

                <div class="subtitle-link text-white mt-3 text-center">
                    <p><a asp-action="Login">Back to Login</a></p>
                </div>
            </form>
        </div>
    </div>
</div>
