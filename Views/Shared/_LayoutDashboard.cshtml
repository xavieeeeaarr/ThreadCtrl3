<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            margin: 0;
            background: #131211;
            color: #ffffff;
            font-family: Segoe UI, sans-serif;
            overflow-x: hidden;
        }

        .app-container {
            display: flex;
            height: 100vh;
            transition: all 0.3s ease;
        }

        /* Sidebar Styles */
        .sidebar {
            display: flex;
            flex-direction: column;
            width: 250px;
            background: #131211;
            color: #ffffff;
            transition: all 0.3s ease;
            z-index: 1000;
            border-right: 1px solid rgba(255,255,255,0.05);
            padding: 10px;
        }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
        }

        .sidebar a {
            display: block;
            color: #ffffff;
            padding: 12px 20px;
            text-decoration: none;
            transition: all 0.2s;
            border-radius: 8px;
            margin: 4px 0;
        }

        .sidebar a:hover:not(.active) {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .sidebar a.active {
            background: #a7d417;
            color: #131211 !important;
            font-weight: 600;
        }

        .sidebar a i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        .logout-section {
            padding: 20px;
            border-top: 1px solid rgba(0,0,0,0.1);
        }

        /* Main Content Styles */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            width: 100%;
            min-width: 0;
            background: #131211;
        }

        .content-area {
            padding: 20px;
            flex: 1;
            overflow-x: hidden;
            background: #131211 !important;
        }

        /* Top Bar Styles */
        .top-bar {
            background: #1a1a1a;
            border-bottom: 1px solid #333;
            padding: 10px 20px;
        }

        .top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .system-name {
            color: #ffffff !important;
            font-weight: 600;
        }



        /* Responsive Utilities */
        .table-responsive {
            display: block;
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* Toggle Button */
        .sidebar-toggle {
            background: transparent;
            border: none;
            font-size: 24px;
            color: #ffffff;
            padding: 10px;
            cursor: pointer;
        }

        /* Responsive Breakpoints */
        @@media (max-width: 1024px) {
            .sidebar {
                position: fixed;
                left: -250px;
                top: 0;
                bottom: 0;
                height: 100vh;
                box-shadow: 2px 0 10px rgba(0,0,0,0.5);
            }

            .sidebar.active {
                left: 0;
            }

            .sidebar-toggle {
                display: block;
            }

            .top-row {
                justify-content: space-between !important;
            }

            .dashboard-title {
                font-size: 16px !important;
            }

            .content-area {
                padding: 15px;
            }
        }

        /* iPad and Tablets specifically */
        @@media (min-width: 768px) and (max-width: 1024px) {
            .cards-grid, .dashboard-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
        }

        /* Small mobile */
        @@media (max-width: 767.98px) {
            .cards-grid, .dashboard-grid, .lower-grid {
                grid-template-columns: 1fr !important;
            }

            .overview-header {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 15px;
            }

            .overview-actions {
                width: 100%;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .overview-actions button {
                width: 100%;
                margin: 0 !important;
            }


        }

        /* Overlay for mobile */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 999;
        }

        .sidebar-overlay.active {
            display: block;
        }
    </style>

</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-container">

        <!-- SIDEBAR -->
        <div class="sidebar text-white" id="sidebar">
            <div class="logo-main ms-4 mt-2 mb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <img src="~/images/logo.png" alt="Logo" style="max-width: 150px;" />
                    <button class="btn d-lg-none text-white" id="closeSidebar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

                @{
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    bool IsActive(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
                }
                <a asp-controller="Test" asp-action="Dashboard" class="@(IsActive("Dashboard") ? "active" : "")"><i class="bi bi-clipboard-data-fill"></i> Dashboard</a>
                
                @if (User.IsInRole("Super Admin") || User.IsInRole("Company Admin") || User.IsInRole("Inventory Manager") || User.IsInRole("Auditor"))
                {
                    <a asp-controller="Test" asp-action="Report" class="@(IsActive("Report") ? "active" : "")"><i class="bi bi-file-earmark-bar-graph-fill"></i> Reports & Valuation</a>
                }

                @if (User.IsInRole("Super Admin") || User.IsInRole("Company Admin") || User.IsInRole("Inventory Manager") || User.IsInRole("Sales Staff") || User.IsInRole("Procurement Officer") || User.IsInRole("Auditor"))
                {
                    <a asp-controller="Test" asp-action="Inventory" class="@(IsActive("Inventory") ? "active" : "")"><i class="bi bi-archive-fill"></i> Inventory</a>
                }

                @if (User.IsInRole("Super Admin") || User.IsInRole("Company Admin") || User.IsInRole("Sales Staff"))
                {
                    <a asp-controller="Test" asp-action="Sales" class="@(IsActive("Sales") ? "active" : "")"><i class="bi bi-cart-dash-fill"></i> Sales Orders</a>
                }

                @if (User.IsInRole("Super Admin") || User.IsInRole("Company Admin") || User.IsInRole("Procurement Officer"))
                {
                    <a asp-controller="Test" asp-action="Procurement" class="@(IsActive("Procurement") ? "active" : "")"><i class="bi bi-basket2-fill"></i> Procurement</a>
                }

                @if (User.IsInRole("Super Admin") || User.IsInRole("Company Admin") || User.IsInRole("Inventory Manager") || User.IsInRole("Auditor"))
                {
                    <a asp-controller="Test" asp-action="Stock" class="@(IsActive("Stock") ? "active" : "")"><i class="bi bi-box-seam-fill"></i> Stock Adjustments</a>
                }

                @if (User.IsInRole("Super Admin") || User.IsInRole("Company Admin"))
                {
                    <a asp-controller="Test" asp-action="UserManagement" class="@(IsActive("UserManagement") ? "active" : "")"><i class="bi bi-person-fill-add"></i> User Management</a>
                }

                @if (User.IsInRole("Super Admin"))
                {
                    <a asp-controller="Test" asp-action="GlobalSecurity" class="@(IsActive("GlobalSecurity") ? "active" : "")"><i class="bi bi-globe"></i> Global Security</a>
                }
                else if (User.IsInRole("Company Admin") || User.IsInRole("Auditor"))
                {
                    <a asp-controller="Test" asp-action="Security" class="@(IsActive("Security") ? "active" : "")"><i class="bi bi-shield-fill-exclamation"></i> Security & Audit</a>
                }


            <div class="logout-section">
                <a asp-controller="Test" asp-action="Logout" class="btn btn-danger w-100 text-white">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </div>

        <!-- MAIN -->
        <div class="main-content">

            <div class="top-bar">
                <div class="top-row">
                    <div class="d-flex align-items-center">
                        <button class="sidebar-toggle me-2" id="toggleSidebar">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="dashboard-title system-name text-white">
                            @ViewData["Title"]
                        </div>
                    </div>

                    <div class="text-white d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle fs-4"></i>
                        <div class="d-flex flex-column align-items-start lh-1">
                            <div class="fw-bold fw-normal" style="font-size: 0.9rem;">Hello, @(User.Identity?.Name ?? "User")</div>
                            @{
                                var company = User.FindFirst("CompanyName")?.Value;
                                var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                            }
                            <div class="text-white-50" style="font-size: 0.75rem;">
                                @(string.IsNullOrEmpty(company) ? "" : company + " | ") @role
                            </div>
                        </div>
                    </div>
                </div>

                @* Search input removed as requested *@
            </div>

            <div class="content-area">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            function toggleSidebar() {
                $('#sidebar').toggleClass('active');
                $('#sidebarOverlay').toggleClass('active');
            }

            $('#toggleSidebar, #closeSidebar, #sidebarOverlay').on('click', function() {
                toggleSidebar();
            });

            // Close sidebar when clicking a nav link on mobile
            $('.sidebar-nav a').on('click', function() {
                if ($(window).width() < 992) {
                    toggleSidebar();
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
